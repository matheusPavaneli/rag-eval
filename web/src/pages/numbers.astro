---
import Base from '../layouts/Base.astro';
import type { ConfigurationRow } from '../lib/data';
import { site } from '../lib/data';
import { decimal, percent, withBase } from '../lib/format';

const payload = site();
const configurations = payload.configurations;
const best = {
  recall: Math.max(...configurations.map((row) => row.context_recall_at_k)),
  mrr: Math.max(...configurations.map((row) => row.mrr_at_k)),
};

const SHORT: Record<string, string> = {
  Dense: 'Dense',
  'Full-text': 'Full-text',
  BM25: 'BM25',
  'Hybrid · dense + BM25': 'Hybrid BM25',
  'Hybrid · dense + Full-text': 'Hybrid FT',
  'Rerank over Dense': 'Rerank dense',
  'Rerank over Hybrid · dense + BM25': 'Rerank hybrid',
};

function short(row: ConfigurationRow): string {
  return SHORT[row.label] ?? row.label;
}

function rank(row: ConfigurationRow, id: string): number | null {
  const score = row.results.find((result) => result.id === id);
  if (score === undefined || score.reciprocal_rank === 0) return null;
  return Math.round(1 / score.reciprocal_rank);
}

const missedByAll = payload.questions
  .filter((question) => configurations.every((row) => rank(row, question.id) === null))
  .map((question) => question.id);
const hits = payload.questions.filter((question) => question.citation_hit).length;
---

<Base
  title="Numbers · rageval"
  description="Context recall and MRR at 5 for seven retrieval configurations over the same thirty questions, read question by question."
  current="numbers"
>
  <main id="main" class="numbers">
    <header class="intro">
      <p class="eyebrow mono">corpus {payload.corpus_version} · k = {payload.k} · {payload.question_count} questions</p>
      <h1>Seven retrievers, the same thirty questions</h1>
      <p class="lead">
        Recall is the share of expected passages found anywhere in the top {payload.k}. MRR is how
        high the first one sat. Either alone misleads, so both are shown, and every row can be read
        question by question below.
      </p>
    </header>

    <section aria-labelledby="configurations">
      <h2 id="configurations" class="label">Retrieval</h2>
      <div class="scroller" tabindex="0" role="region" aria-labelledby="configurations">
        <table class="configs">
          <thead>
            <tr>
              <th scope="col">Configuration</th>
              <th scope="col">Recall @{payload.k}</th>
              <th scope="col">MRR @{payload.k}</th>
              <th scope="col">In CI</th>
            </tr>
          </thead>
          <tbody>
            {
              configurations.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  <td>
                    <span class="bar" style={`--v: ${row.context_recall_at_k}`}>
                      <span class:list={['value', 'mono', { best: row.context_recall_at_k === best.recall }]}>
                        {decimal(row.context_recall_at_k)}
                      </span>
                    </span>
                  </td>
                  <td>
                    <span class="bar" style={`--v: ${row.mrr_at_k}`}>
                      <span class:list={['value', 'mono', { best: row.mrr_at_k === best.mrr }]}>
                        {decimal(row.mrr_at_k)}
                      </span>
                    </span>
                  </td>
                  <td class="gate">{row.gated ? 'Gated' : 'Recorded'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="note">
        <strong>Gated</strong> rows are compared with their frozen report on every pull request; any
        change in any question fails the build. <strong>Recorded</strong> rows were measured once and
        published as they came out. The best value in each column is in bold.
      </p>
    </section>

    <section aria-labelledby="answers">
      <h2 id="answers" class="label">Answers over dense retrieval</h2>
      <dl class="figures">
        <div>
          <dt>Citation hit @{payload.k}</dt>
          <dd class="mono">{decimal(payload.citation_hit_rate)}</dd>
          <dd class="detail">{hits} of {payload.question_count} answers cite the expected passage</dd>
        </div>
        <div>
          <dt>Over retrieved gold</dt>
          <dd class="mono">{decimal(payload.citation_hit_rate_retrieved)}</dd>
          <dd class="detail">of the {payload.retrieved_count} whose expected passage was retrieved</dd>
        </div>
        <div>
          <dt>Quotes found verbatim</dt>
          <dd class="mono">{payload.resolved_count}/{payload.citation_count}</dd>
          <dd class="detail">{percent(payload.resolution_rate)} of citations resolve to a span</dd>
        </div>
      </dl>
      <p class="note">
        A hit means a citation overlaps the one span the golden set records, so the rate is a lower
        bound: several misses cite another sentence of the same PEP that also answers the question.
        Answered by {Object.entries(payload.providers).map(([name, count]) => `${name} (${count})`).join(', ')},
        prompt <span class="mono">{payload.prompt_version}</span>.
      </p>
    </section>

    <section aria-labelledby="per-question">
      <h2 id="per-question" class="label">Question by question</h2>
      <p class="note">
        Each cell is the rank at which the expected passage first appeared, 1 to {payload.k}; a dash
        means it was not in the top {payload.k}. {missedByAll.length} questions are missed by every
        configuration: {missedByAll.join(', ')}.
      </p>
      <div class="scroller" tabindex="0" role="region" aria-labelledby="per-question">
        <table class="grid">
          <thead>
            <tr>
              <th scope="col">Question</th>
              {configurations.map((row) => <th scope="col" title={row.label}>{short(row)}</th>)}
              <th scope="col">Answer</th>
            </tr>
          </thead>
          <tbody>
            {
              payload.questions.map((question) => (
                <tr class:list={{ unreached: missedByAll.includes(question.id) }}>
                  <th scope="row">
                    <a href={withBase(`/q/${question.id}/`)}>
                      <span class="mono">{question.id}</span>
                      <span class="q">{question.question}</span>
                    </a>
                  </th>
                  {configurations.map((row) => {
                    const at = rank(row, question.id);
                    return (
                      <td class:list={['cell', 'mono', at === null ? 'none' : `r${at}`]}>
                        {at === null ? <span aria-label="not retrieved">–</span> : at}
                      </td>
                    );
                  })}
                  <td class:list={['verdict', 'mono', question.citation_hit ? 'hit' : 'miss']}>
                    {question.citation_hit ? 'hit' : question.retrieved ? 'miss' : 'n/r'}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </main>
</Base>

<style>
  .numbers {
    display: grid;
    gap: var(--space-12);
    max-inline-size: 72rem;
    padding: var(--space-8) var(--space-6) var(--space-12);
  }
  .numbers > * {
    min-inline-size: 0;
  }

  .eyebrow {
    color: var(--muted);
    font-size: var(--text-xs);
    margin-block-end: var(--space-2);
  }
  h1 {
    max-inline-size: 28ch;
    font-size: var(--text-xl);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .lead {
    max-inline-size: 60ch;
    margin-block-start: var(--space-4);
    font-size: var(--text-md);
    color: var(--muted);
  }

  .label {
    margin-block-end: var(--space-3);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .note {
    max-inline-size: 70ch;
    margin-block: var(--space-3);
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .note strong {
    color: var(--ink);
    font-weight: 600;
  }

  .scroller {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
  }

  table {
    inline-size: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  th,
  td {
    padding: var(--space-2) var(--space-3);
    text-align: start;
    border-block-end: 1px solid var(--border);
    font-weight: 400;
  }
  tbody tr:last-child > * {
    border-block-end: 0;
  }
  thead th {
    color: var(--muted);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .configs th[scope='row'] {
    min-inline-size: 14rem;
  }
  .bar {
    --fill: color-mix(in oklch, var(--act) 22%, var(--ground));
    display: block;
    position: relative;
    min-inline-size: 9rem;
    block-size: 1.5rem;
    border-radius: var(--radius-mark);
    background: var(--raised) linear-gradient(var(--fill), var(--fill)) no-repeat left /
      calc(var(--v) * 100%) 100%;
  }
  .value {
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--space-2);
    display: flex;
    align-items: center;
    font-size: var(--text-xs);
  }
  .value.best {
    font-weight: 700;
  }
  .gate {
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-4);
  }
  .figures > div {
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
  }
  .figures dt {
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .figures dd.mono {
    font-size: var(--text-lg);
    font-weight: 500;
  }
  .figures .detail {
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .grid th[scope='row'] {
    position: sticky;
    inset-inline-start: 0;
    background: var(--ground);
    min-inline-size: 16rem;
    max-inline-size: 22rem;
  }
  .grid th[scope='row'] a {
    display: flex;
    gap: var(--space-2);
    min-block-size: var(--control);
    align-items: center;
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-xs);
  }
  .grid th[scope='row'] a:hover .q {
    text-decoration: underline;
  }
  .grid th[scope='row'] .mono {
    color: var(--muted);
  }
  .q {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cell {
    text-align: center;
    font-size: var(--text-xs);
    min-inline-size: 4.5rem;
  }
  .cell.r1 {
    background: color-mix(in oklch, var(--act) 28%, var(--ground));
  }
  .cell.r2 {
    background: color-mix(in oklch, var(--act) 18%, var(--ground));
  }
  .cell.r3,
  .cell.r4,
  .cell.r5 {
    background: color-mix(in oklch, var(--act) 9%, var(--ground));
  }
  .cell.none {
    color: var(--muted);
  }
  .unreached th[scope='row'] .mono {
    color: var(--miss);
  }
  .verdict {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .verdict.hit {
    color: var(--act);
  }
  .verdict.miss {
    color: var(--miss);
  }

  @media (max-width: 767px) {
    .numbers {
      padding-inline: var(--space-4);
      gap: var(--space-8);
    }
    h1 {
      font-size: var(--text-lg);
    }
    .grid th[scope='row'] {
      min-inline-size: 9rem;
    }
    .configs th[scope='row'] {
      min-inline-size: 8rem;
    }
    .bar {
      min-inline-size: 4.5rem;
    }
    th,
    td {
      padding-inline: var(--space-2);
    }
    .q {
      display: none;
    }
  }
</style>
