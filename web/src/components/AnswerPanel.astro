---
import type { QuestionPage } from '../lib/data';
import { interval, pep, reason } from '../lib/format';

interface Props {
  page: QuestionPage;
  lede?: boolean;
}

const { page, lede = false } = Astro.props;
const resolved = page.citations.filter((citation) => citation.status === 'resolved');

const verdict = page.citation_hit
  ? {
      tone: 'hit',
      label: 'Hit',
      text: 'A citation overlaps the passage the golden set expects.',
    }
  : page.context_recall > 0
    ? {
        tone: 'miss',
        label: 'Miss',
        text: 'The expected passage was retrieved, but no citation overlaps it.',
      }
    : {
        tone: 'absent',
        label: 'Not retrieved',
        text: 'The expected passage was not in the top five, so no citation could land on it.',
      };
---

<section class="answer" aria-labelledby="question">
  {
    lede && (
      <p class="lede">
        Each answer cites its sources by quoting them. The pipeline then finds every quote in the
        source document and records the exact characters it occupies.
      </p>
    )
  }

  <p class="eyebrow mono">
    {page.id} · answered by {page.provider}/{page.model}
  </p>
  <h1 id="question">{page.question}</h1>

  <h2 class="label">Answer</h2>
  {
    page.answer !== null ? (
      <p class="prose">{page.answer}</p>
    ) : (
      <p class="prose problem">
        The model's reply could not be read as an answer: {page.parse_error ?? 'no reason recorded'}.
      </p>
    )
  }

  <h2 class="label">
    Citations <span class="count mono">{resolved.length}/{page.citations.length} found</span>
  </h2>
  {
    page.citations.length === 0 ? (
      <p class="prose problem">The answer cites nothing, so there is nothing to check it against.</p>
    ) : (
      <>
      <p class="hint">Select a citation to see its characters in the source.</p>
      <ol class="citations">
        {page.citations.map((citation, index) => {
          const number = index + 1;
          if (citation.status === 'resolved') {
            return (
              <li>
                <a class="chip" href={`#c${number}`} data-chip={`c${number}`}>
                  <span class="n mono" aria-hidden="true">
                    {number}
                  </span>
                  <span class="quote">{citation.quote}</span>
                  <span class="where mono">
                    {pep(citation.source_path)} · {interval(citation.start_char, citation.end_char)}
                  </span>
                  <span class="visually-hidden">Show citation {number} in the source</span>
                </a>
              </li>
            );
          }
          return (
            <li>
              <div class="chip unresolved">
                <span class="n mono" aria-hidden="true">
                  {number}
                </span>
                <span class="quote">{citation.quote}</span>
                <span class="where">
                  <strong>Not found in the source.</strong> {reason(citation.reason)}
                </span>
              </div>
            </li>
          );
        })}
      </ol>
      </>
    )
  }

  <h2 class="label">Expected by the golden set</h2>
  <div class:list={['verdict', verdict.tone]}>
    <p><strong class="mono">{verdict.label}</strong> — {verdict.text}</p>
    <ul class="supports">
      {
        page.supports.map((support, index) => (
          <li>
            <a href={`#e${index + 1}`} class="mono">
              {pep(support.source_path)} · {interval(support.start_char, support.end_char)}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="golden">Golden answer: {page.expected_answer}</p>
  </div>
</section>

<style>
  .answer {
    padding: var(--space-8) var(--space-8) var(--space-12);
    max-inline-size: 40rem;
  }

  .lede {
    max-inline-size: 60ch;
    margin-block-end: var(--space-6);
    padding-block-end: var(--space-6);
    border-block-end: 1px solid var(--border);
    color: var(--muted);
  }

  .eyebrow {
    color: var(--muted);
    font-size: var(--text-xs);
    margin-block-end: var(--space-2);
    overflow-wrap: anywhere;
  }

  h1 {
    max-inline-size: 28ch;
    font-size: var(--text-xl);
    line-height: 1.15;
    font-weight: 650;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .label {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-block: var(--space-8) var(--space-3);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .count {
    letter-spacing: 0;
    text-transform: none;
  }

  .prose {
    max-inline-size: 60ch;
    font-size: var(--text-md);
    line-height: 1.6;
  }
  .problem {
    color: var(--miss);
  }

  .hint {
    margin-block-end: var(--space-3);
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .citations {
    display: grid;
    gap: var(--space-2);
  }

  .chip {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    grid-template-areas: 'n quote' '. where';
    gap: var(--space-1) var(--space-2);
    padding: var(--space-3);
    min-block-size: var(--control);
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color var(--duration-state) ease,
      box-shadow var(--duration-state) ease;
  }
  a.chip:hover {
    border-color: var(--act);
  }

  .n {
    grid-area: n;
    display: grid;
    place-items: center;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border-radius: var(--radius-mark);
    background: var(--cite);
    color: var(--on-cite);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .unresolved {
    border-style: dashed;
  }
  .unresolved .n {
    background: transparent;
    color: var(--miss);
    box-shadow: inset 0 0 0 1px var(--miss);
  }

  .quote {
    grid-area: quote;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .quote::before {
    content: '“';
  }
  .quote::after {
    content: '”';
  }

  .where {
    grid-area: where;
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .unresolved .where strong {
    color: var(--miss);
    font-weight: 600;
  }

  .verdict {
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    display: grid;
    gap: var(--space-2);
  }
  .verdict strong {
    font-weight: 600;
  }
  .verdict.hit strong {
    color: var(--act);
  }
  .verdict.miss strong {
    color: var(--miss);
  }
  .supports a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control);
    font-size: var(--text-xs);
    text-decoration-style: dashed;
  }
  .golden {
    color: var(--muted);
    font-size: var(--text-xs);
  }

  @media (max-width: 767px) {
    .answer {
      padding: var(--space-6) var(--space-4) var(--space-8);
    }
    h1 {
      font-size: var(--text-lg);
    }
  }
</style>
